  m_Name: 
  m_EditorClassIdentifier: 
  CharacterNameRus: "\u0414\u0440\u0443\u0433 \u0411\u043E\u0431"
  CharacterNameEn: Friend  Bob
  Phrases:
  - PhraseTextRus: "\u0414\u0440\u0443\u0433, \u043D\u0430\u0441 \u0432\u0441\u0435
      \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u043B\u0438!"
    PhraseTextEn: 
  - PhraseTextRus: "\u0421\u043D\u0438\u043C\u0438 \u043E\u0447\u043A\u0438 \u0438
      \u0443\u0432\u0438\u0434\u0438\u0448\u044C \u0438\u0441\u0442\u0438\u043D\u0443!"
    PhraseTextEn: 
  - PhraseTextRus: "\u042F \u043E\u0442\u043A\u043B\u044E\u0447\u0443 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
      \u0431\u0430\u0448\u043D\u044E"
    PhraseTextEn: 
  - PhraseTextRus: "\u0418 \u0442\u043E\u0433\u0434\u0430 \u0442\u044B \u043C\u043D\u0435
      \u043F\u043E\u0432\u0435\u0440\u0438\u0448\u044C"
    PhraseTextEn: 
  DialogTime: 2.7
